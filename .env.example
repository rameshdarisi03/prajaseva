# 1. Supabase Configuration (Future-Proof Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# 2. Zoho Drive Storage
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_WORKDRIVE_FOLDER_ID=your-folder-id

# 3. Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=your-meta-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-id
META_WHATSAPP_WABA_ID=your-waba-id

# 4. Base Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
